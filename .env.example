# NovaCode Cloud - Environment Configuration Template

# GitHub Credentials (Use Kaggle Secrets in Remote Runtime)
GITHUB_TOKEN=ghp_example_fine_grained_token
GITHUB_USER=your-github-username
GITHUB_REPO=your-repo-name
GITHUB_EMAIL=your-email@example.com

# Model & vLLM Configuration
PRIMARY_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ
FALLBACK_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=auto

# Server & Runtime Configuration
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
OPENCODE_PORT=3000
CACHE_DIR=/kaggle/working/cache
LOG_DIR=/kaggle/working/logs
