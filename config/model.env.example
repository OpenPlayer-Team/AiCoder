# NovaCode Cloud - Model Routing & Selection Configuration

# Primary Model Option (For Dual T4 or High VRAM GPUs)
PRIMARY_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ
PRIMARY_QUANTIZATION=awq
PRIMARY_MAX_LEN=32768

# Fallback Model Option 1 (Single T4 / Moderate VRAM)
FALLBACK_MODEL_1=Qwen/Qwen2.5-Coder-3B-Instruct
FALLBACK_QUANTIZATION_1=none
FALLBACK_MAX_LEN_1=16384

# Fallback Model Option 2 (Low VRAM / P100 / Emergency CPU fallback)
FALLBACK_MODEL_2=Qwen/Qwen2.5-Coder-1.5B-Instruct
FALLBACK_QUANTIZATION_2=none
FALLBACK_MAX_LEN_2=8192

# Dynamic Resource Thresholds
MIN_VRAM_PRIMARY_MB=12000
MIN_VRAM_FALLBACK_1_MB=7000
MIN_VRAM_FALLBACK_2_MB=3500
