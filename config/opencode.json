{
  "$schema": "https://opencode.ai/config.schema.json",
  "version": "1.0",
  "provider": {
    "type": "openai",
    "baseUrl": "http://127.0.0.1:8000/v1",
    "apiKey": "EMPTY",
    "model": "Qwen/Qwen2.5-Coder-7B-Instruct-AWQ"
  },
  "agent": {
    "name": "NovaCode-Agent",
    "safety": {
      "confirmDestructive": true,
      "disallowForcePush": true,
      "disallowHardReset": true,
      "disallowRootDelete": true,
      "protectedCommands": [
        "rm -rf /",
        "rm -rf *",
        "git push --force",
        "git push -f",
        "git reset --hard"
      ]
    },
    "workflow": {
      "enforceGitFlow": true,
      "requireTestsBeforeCommit": true,
      "autoDiffCheck": true
    }
  },
  "context": {
    "maxTokens": 32768,
    "temperature": 0.2,
    "topP": 0.95
  }
}
